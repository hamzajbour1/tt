-- nova_probe6.lua — hook الموزّع المركزي (ProcPkg2Handler/OnRecvPkg) + تسجيل الحركة الحيّة
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe6.txt"
local NETLOG = "/sdcard/Android/data/com.tencent.ig/files/nova_net_live.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA6] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA6] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-34s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end

W("========= NOVA PROBE 6 =========")
local NM = require("client.network.comm.NetManager")

-- [1] افحص توقيع ProcPkg2Handler و OnRecvPkg و GetMsgHandlerByInfo
W("---- [1] دوال الموزّع ----")
for _,m in ipairs({"ProcPkg2Handler","OnRecvPkg","GetMsgHandlerByInfo","FindMsgInfo",
    "FindMsgInfoByReqName","ProcRespondMsg","AppendModConfig","CheckResCode"}) do
  T("NM."..m, function() return type(NM[m]) end)
end

-- [2] hook ProcPkg2Handler — يسجّل كل رسالة s2c (الاسم + النوع)
W("---- [2] hook ProcPkg2Handler ----")
T("install dispatch hook", function()
  if type(NM.ProcPkg2Handler)~="function" then return "no ProcPkg2Handler" end
  if NM.__nova6 then return "already" end
  local orig = NM.ProcPkg2Handler
  NM.__nova6 = true
  local count = 0
  NM.ProcPkg2Handler = function(self, ...)
    local args = {...}
    pcall(function()
      count = count + 1
      -- حاول استخراج اسم الرسالة من الوسائط
      local desc = ""
      for i=1,math.min(4,#args) do
        local a = args[i]
        if type(a)=="string" then desc = desc.." s:"..a:sub(1,50)
        elseif type(a)=="table" then
          local nm = a.name or a.msgName or a.rspName or a.cmd or a.sMsgName
          if nm then desc = desc.." t.name:"..tostring(nm):sub(1,50) end
        end
      end
      if count <= 400 then
        local f=io.open(NETLOG,"a")
        if f then f:write(count.." S2C"..desc.."\n"); f:close() end
      end
    end)
    return orig(self, ...)
  end
  return "hooked -> nova_net_live.txt (العب قليلاً ثم اقرأه)"
end)

-- [3] كيف يحلّ ProcPkg2Handler المعالج؟ افحص GetMsgHandlerByInfo
W("---- [3] آلية حلّ المعالج ----")
-- افحص عيّنة من NetRsp2IndexConfig: ما بنية الإدخال؟
T("sample idx entry structure", function()
  local idx = require("client.network.comm.NetRsp2IndexConfig")
  for k,v in pairs(idx) do
    if type(v)=="table" then
      local keys = {}
      for kk,vv in pairs(v) do keys[#keys+1]=tostring(kk).."="..type(vv) end
      return k.." -> {"..table.concat(keys,", ").."}"
    end
  end
  return "none"
end)

-- [4] هل نستطيع حقن إدخال جديد في NetRsp2IndexConfig يشير لمعالجنا؟
W("---- [4] اختبار تسجيل معالج مخصّص ----")
T("inject custom handler into idx", function()
  local idx = require("client.network.comm.NetRsp2IndexConfig")
  -- احفظ بنية إدخال موجود للتقليد
  local sample
  for k,v in pairs(idx) do if type(v)=="table" then sample=v; break end end
  if not sample then return "no sample" end
  -- أنشئ إدخالاً وهمياً (لا نفعّله فعلياً الآن، فقط نرى إن كان قابلاً للكتابة)
  local okw = pcall(function() idx["nova_test_channel"] = {__nova=true} end)
  local readback = idx["nova_test_channel"]
  idx["nova_test_channel"] = nil -- نظّف
  return "writable="..tostring(okw).." readback="..tostring(readback~=nil)
end)

-- [5] أعد تثبيت مستمع GM (احتياط)
pcall(function()
  local hud = GENV.slua_GameFrontendHUD
  if hud and hud.OnCloudGMReceive then
    hud.OnCloudGMReceive:Add(function(cmd)
      pcall(function() local f=io.open("/sdcard/Android/data/com.tencent.ig/files/nova_gm_log.txt","a")
        if f then f:write(os.time().." GM="..tostring(cmd).."\n"); f:close() end end)
    end)
  end
end)

W("========= END (العب دقيقة ثم اقرأ nova_net_live.txt) =========")
flush()
return "DONE lines="..#L
