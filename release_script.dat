-- nova_probe4.lua — إيجاد موزّع الشبكة→Lua + أدوات + إبقاء مستمع GM
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe4.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA4] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA4] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-34s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end

W("========= NOVA PROBE 4 =========")

-- [1] أعد تثبيت مستمع GM (في حال أُعيد تحميل السكربت)
W("---- [1] GM listener ----")
T("re-add GM listener", function()
  local hud = GENV.slua_GameFrontendHUD or GENV.GameFrontendHUD
  local dg = hud and hud.OnCloudGMReceive
  if not dg then return "no delegate" end
  dg:Add(function(cmd)
    pcall(function()
      local f=io.open("/sdcard/Android/data/com.tencent.ig/files/nova_gm_log.txt","a")
      if f then f:write(os.time().." GM="..tostring(cmd).."\n"); f:close() end
    end)
  end)
  return "listener (re)added"
end)

-- [2] ابحث عن وحدات الشبكة/البروتوكول في package.loaded
W("---- [2] وحدات الشبكة/البروتوكول ----")
local netmods = {}
pcall(function()
  for k,v in pairs(package.loaded) do
    local ks = tostring(k):lower()
    if (ks:find("protocol") or ks:find("message") or ks:find("msg")
        or ks:find("dispatch") or ks:find("network") or ks:find("logic_net")
        or ks:find("proto") or ks:find("rpc") or ks:find("comm"))
        and type(v)=="table" then
      netmods[#netmods+1] = tostring(k)
    end
  end
end)
table.sort(netmods)
for _,k in ipairs(netmods) do W("  MOD: "..k) end
W("  (count="..#netmods..")")

-- [3] ابحث عن جدول يربط اسم method بـ handler (dispatch table)
-- نفحص كل وحدة شبكة عن حقل فيه مفاتيح نصّية تشبه أسماء الـ RPC
W("---- [3] البحث عن dispatch table (method->handler) ----")
local function looksLikeDispatch(t)
  if type(t)~="table" then return 0 end
  local hits=0
  pcall(function()
    for k,v in pairs(t) do
      if type(k)=="string" and type(v)=="function"
         and (k:find("_rsp") or k:find("_notify") or k:find("_res") or k:find("sync_") or k:find("_ntf")) then
        hits=hits+1
      end
    end
  end)
  return hits
end
for _,mk in ipairs(netmods) do
  local m = package.loaded[mk]
  local direct = looksLikeDispatch(m)
  if direct>=2 then W("  DISPATCH? "..mk.." directHits="..direct) end
  -- افحص الحقول الفرعية أيضاً
  pcall(function()
    for k,v in pairs(m) do
      if type(v)=="table" then
        local h = looksLikeDispatch(v)
        if h>=3 then W("  SUBTABLE "..mk.."."..tostring(k).." rpcHits="..h) end
      end
    end
  end)
end

-- [4] أدوات مفيدة: DecodeBase64 + ExecuteConsoleCommand
W("---- [4] أدوات ----")
local fu = GENV.FuncUtil
T("FuncUtil.DecodeBase64", function() return fu and type(fu.DecodeBase64) end)
T("FuncUtil.UE4ExecuteConsoleCommand", function() return fu and type(fu.UE4ExecuteConsoleCommand) end)
-- ابحث عن أي دالة base64/decode في FuncUtil
pcall(function()
  for k,v in pairs(fu) do
    local ks=tostring(k):lower()
    if (ks:find("base64") or ks:find("decode") or ks:find("decrypt") or ks:find("xor")) and type(v)=="function" then
      W("  fu."..tostring(k).." (decode-like)")
    end
  end
end)

-- [5] slua.HotReload / loadClass / IsLuaModuleExists
W("---- [5] slua قدرات التحميل ----")
T("slua.HotReload", function() return type(slua.HotReload) end)
T("slua.IsLuaModuleExists", function() return type(slua.IsLuaModuleExists) end)
T("IsLuaModuleExists(ClientCloudGM)", function()
  return slua.IsLuaModuleExists and slua.IsLuaModuleExists("GameLua.Mod.BaseMod.Client.ClientCloudGM")
end)
T("IsLuaModuleExists(client.logic.gm.logic_gm_execute)", function()
  return slua.IsLuaModuleExists and slua.IsLuaModuleExists("client.logic.gm.logic_gm_execute")
end)

-- [6] كيف يُحمّل game_frontend_hud الوحدات؟ (نقلّد require الصحيح)
W("---- [6] اختبار require بصيغ مختلفة ----")
for _,key in ipairs({
  "client.logic.gm.logic_gm_execute",
  "blacklist.slua.logic.gm.logic_gm_execute",
  "GameLua.Dev.IngameGM.IngameGMManager",
  "client.common.ui_util",
}) do
  local ok,v = pcall(require, key)
  W("  require('"..key.."'): ok="..tostring(ok).." type="..type(v))
end

W("========= END =========")
flush()
return "DONE lines="..#L
