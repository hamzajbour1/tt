-- nova_probe3.lua — فحص delegate الأصلي + NetUtil (جسر الشبكة→Lua) + تحميل الوحدات
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe3.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA3] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA3] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-36s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end
local function methods(ud, names)
  for _,m in ipairs(names) do
    T("  ."..m, function() return type(ud[m]) end)
  end
end

W("========= NOVA PROBE 3 =========")

-- [1] delegate OnCloudGMReceive على slua_GameFrontendHUD
W("---- [1] OnCloudGMReceive delegate ----")
local hud = GENV.slua_GameFrontendHUD or GENV.GameFrontendHUD
T("hud userdata", function() return type(hud) end)
local dg = T("hud.OnCloudGMReceive", function() return hud and hud.OnCloudGMReceive end)
if dg then
  W("  delegate methods:")
  methods(dg, {"Add","Remove","Clear","Broadcast","Contains","Clone"})
  -- أضف مستمعنا لرصد أوامر GM من المصدر الأصلي
  T("  Add our listener", function()
    dg:Add(function(cmd)
      pcall(function()
        local f=io.open("/sdcard/Android/data/com.tencent.ig/files/nova_gm_log.txt","a")
        if f then f:write(os.time().." NATIVE_GM="..tostring(cmd).."\n"); f:close() end
        if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA3][NATIVE_GM] "..tostring(cmd):sub(1,200)) end
      end)
    end)
    return "listener added"
  end)
  -- جرّب Broadcast لمحاكاة أمر GM (يثبت المسار كله)
  T("  TRY Broadcast(test)", function()
    if type(dg.Broadcast)~="function" then return "no Broadcast" end
    dg:Broadcast("NOVA_TEST_GM_CMD")
    return "broadcast sent (check nova_gm_log + status)"
  end)
end

-- [2] NetUtil — جسر الشبكة→Lua (الأهم)
W("---- [2] NetUtil ----")
local net = GENV.NetUtil
T("NetUtil type", function() return type(net) end)
if net then
  W("  NetUtil methods:")
  methods(net, {"s2c","c2s","unreg_s2c","unreg_c2s","SendPkg","SendTime",
                "reg","register","RegisterS2C","AddHandler","dispatch",
                "Send","Recv","OnRecv","RegisterProtocol","BindProtocol"})
  -- حاول تعداد الحقول إن كانت table أو لها __pairs
  T("  is table", function() return type(net)=="table" end)
  if type(net)=="table" then
    local cnt=0
    pcall(function() for k,v in pairs(net) do cnt=cnt+1
      if cnt<=40 then W("    net."..tostring(k).." = "..type(v)) end end end)
    W("  (NetUtil field count="..cnt..")")
  end
end

-- [3] FuncUtil (DecodeBase64 وغيره)
W("---- [3] FuncUtil ----")
local fu = GENV.FuncUtil
T("FuncUtil type", function() return type(fu) end)
if type(fu)=="table" then
  local cnt=0
  pcall(function() for k,v in pairs(fu) do cnt=cnt+1
    if cnt<=30 then W("    fu."..tostring(k).." = "..type(v)) end end end)
  W("  (FuncUtil field count="..cnt..")")
end

-- [4] حمّل ClientCloudGM و logic_gm_execute يدوياً
W("---- [4] تحميل الوحدات يدوياً ----")
-- game_frontend_hud يستخدم require("GameLua.Mod.BaseMod.Client.ClientCloudGM")
-- جرّب نفس الاستدعاء عبر require العالمي (قد ينجح الآن)
local okc, C = pcall(require, "GameLua.Mod.BaseMod.Client.ClientCloudGM")
W("  require ClientCloudGM: ok="..tostring(okc).." type="..type(C))
if not okc then
  -- ربما require يحتاج صيغة slash أو __index من slua
  for _,key in ipairs({
    "GameLua/Mod/BaseMod/Client/ClientCloudGM",
    "blacklist.GameLua.Mod.BaseMod.Client.ClientCloudGM",
  }) do
    local ok2,v2 = pcall(require, key)
    W("  require '"..key.."': ok="..tostring(ok2).." type="..type(v2))
    if ok2 then C=v2; break end
  end
end
T("ClientCloudGM.HandleCloudGMCMDStr", function() return C and type(C.HandleCloudGMCMDStr) end)

-- [5] slua object — ماذا يكشف؟
W("---- [5] slua ----")
T("slua type", function() return type(slua) end)
if type(slua)=="table" then
  local cnt=0
  pcall(function() for k,v in pairs(slua) do cnt=cnt+1
    if cnt<=40 then W("    slua."..tostring(k).." = "..type(v)) end end end)
  W("  (slua field count="..cnt..")")
end

W("========= END =========")
flush()
return "DONE lines="..#L
