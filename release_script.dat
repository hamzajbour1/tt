-- nova_probe7.lua — آلية تحميل/تحقّق ODPAK (المسار الشبكي الأخير)
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe7.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA7] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA7] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-36s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end
local function dump(t,p,m) local c=0 pcall(function() for k,v in pairs(t) do c=c+1 if c<=(m or 40) then W(p..tostring(k).." = "..type(v)) end end end) return c end

W("========= NOVA PROBE 7 =========")

-- [1] pak_util — كيف تُركّب/تُحمّل الـ paks
W("---- [1] pak_util ----")
local pu = T("require pak_util", function() return require("client.common.pak_util") end)
if type(pu)=="table" then W("  pak_util fields:"); W("  count="..dump(pu,"    pu.",60)) end

-- [2] PufferManager / download — نظام تنزيل الموارد
W("---- [2] Puffer/download ----")
for _,mod in ipairs({
  "client.slua.logic.download.puffer.puffer_manager",
  "client.slua.logic.download.puffer.logic_puffer_common",
  "client.slua.logic.download.network.logic_puffer_netmanager",
  "client.slua.logic.download.puffer_const",
  "client.common.cdn_downloader",
}) do
  local ok,m = pcall(require, mod)
  W("  "..mod..": ok="..tostring(ok).." type="..type(m))
  if ok and type(m)=="table" then
    pcall(function() for k,v in pairs(m) do
      local ks=tostring(k):lower()
      if type(v)=="function" and (ks:find("load")or ks:find("mount")or ks:find("verify")
         or ks:find("md5")or ks:find("download")or ks:find("decrypt")or ks:find("pak")or ks:find("require")) then
        W("    -> "..k)
      end
    end end)
  end
end

-- [3] ODPAK loading delegate + LobbyModUtils.DownloadMod
W("---- [3] ODPAK / Mod loading ----")
local lmu = T("require LobbyModUtils", function() return require("GameLua.Mod.Lobby.Base.Common.LobbyModUtils") end)
if type(lmu)=="table" then
  pcall(function() for k,v in pairs(lmu) do
    local ks=tostring(k):lower()
    if type(v)=="function" and (ks:find("download")or ks:find("mod")or ks:find("pak")or ks:find("require")or ks:find("res")) then
      W("    lmu."..k)
    end
  end end)
end

-- [4] slua.loadClass / كيف يُحلّ مسار الوحدة (هل من الشبكة؟)
W("---- [4] آلية تحميل الوحدات ----")
T("slua.IsLuaModuleExists", function() return type(slua.IsLuaModuleExists) end)
-- جرّب وحدة mod قد تكون ODPAK
for _,mn in ipairs({
  "GameLua.Mod.CreativeBase.Client.BlockyLuaUI.BlockyLuaCheckResPopupUI",
  "GameLua.Mod.Lobby.Base.CollectBadge",
  "GameLua.Mod.BaseMod.Client.ShootingUI.ShootingUIPanelMain",
}) do
  T("exists? "..mn:sub(-30), function() return slua.IsLuaModuleExists and slua.IsLuaModuleExists(mn) end)
end

-- [5] cdn_downloader / common_download_handler — تنزيل عام شبكي
W("---- [5] common_download_handler ----")
local cdh = T("require common_download_handler", function() return require("client.slua.common.common_download_handler") end)
if type(cdh)=="table" then dump(cdh,"    cdh.",40) end

-- [6] أين ملفات الـ pak على القرص؟ (لنرى ODPAK المُنزّلة)
W("---- [6] مسارات القرص ----")
T("list Paks dir", function()
  local paths = {
    "/sdcard/Android/data/com.tencent.ig/files/UE4Game/ShadowTrackerExtra/ShadowTrackerExtra/Saved/Paks/",
    "/sdcard/Android/data/com.tencent.ig/files/d* ",
  }
  -- io لا يسرد مجلدات؛ نكتفي بالإشارة
  return "see adb ls manually"
end)

W("========= END =========")
flush()
return "DONE lines="..#L
