-- nova_probe9.lua — HDmpveRemote + RemoteControlHelper methods + reautomatic loader
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe9.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA9] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA9] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-40s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end
local imp = GENV.import or import

W("========= NOVA PROBE 9 =========")

-- [1] HDmpveRemote (محمّل ونشط!)
W("---- [1] HDmpveRemote ----")
local hd = T("package.loaded HDmpveRemote", function() return package.loaded["client.slua.logic.HDmpveRemote.HDmpveRemote"] end)
if type(hd)=="table" then
  pcall(function() for k,v in pairs(hd) do
    local ks=tostring(k):lower()
    if type(v)=="function" and (ks:find("lua")or ks:find("exec")or ks:find("run")or ks:find("recv")
       or ks:find("msg")or ks:find("cmd")or ks:find("remote")or ks:find("handle")or ks:find("on")) then
      W("    hd."..tostring(k))
    end
  end end)
  W("  -- all HDmpveRemote keys --")
  local c=0 pcall(function() for k,v in pairs(hd) do c=c+1 if c<=40 then W("    "..tostring(k).." = "..type(v)) end end end)
end

-- [2] RemoteControlHelper — جرّب أسماء دوال UE4 شائعة للأتمتة
W("---- [2] RemoteControlHelper methods (أسماء UE4) ----")
local RC = imp("RemoteControlHelper")
for _,m in ipairs({"GetDeviceName","StartTcpServer","StartTCPServer","StartUDPServer",
  "StartLuaServer","RegisterRunLuaCallback","RegisterCallback","SetRunLuaDelegate",
  "BindRunLuaCallback","RunLua","ExecuteLua","DoLua","StartServerWithPort","StartServerOnPort",
  "StartRemoteServer","Start","Stop","IsServerRunning","GetServerPort","OnReceiveMessage",
  "SendMsg","Send","Broadcast","RegisterLuaCallBack","SetLuaCallback","InitLuaEnv"}) do
  T("  RC."..m, function() return type(RC[m]) end)
end

-- [3] محاولة تحميل reautomatic عبر slua.loadUI/loadClass أو require بديل
W("---- [3] تحميل reautomatic ----")
T("slua.IsLuaModuleExists remote_handler", function()
  return slua.IsLuaModuleExists and slua.IsLuaModuleExists("reautomatic.remote_handler") end)
T("slua.IsLuaModuleExists AutoTest", function()
  return slua.IsLuaModuleExists and slua.IsLuaModuleExists("reautomatic.AutoTest") end)
-- جرّب require بصيغ بديلة
for _,key in ipairs({"reautomatic.remote_handler","reautomatic/remote_handler",
    "blacklist.reautomatic.remote_handler"}) do
  local ok,v = pcall(require, key)
  W("  require('"..key.."'): ok="..tostring(ok).." type="..type(v))
end

-- [4] ScriptHelperClient — قد يكون جسر runLua
W("---- [4] ScriptHelperClient ----")
local SH = imp("ScriptHelperClient")
for _,m in ipairs({"RunLua","ExecuteLua","DoString","RunString","CallLua","GetLuaResult",
  "Start","StartServer","Register","GetDeviceName","Exec"}) do
  T("  SH."..m, function() return type(SH[m]) end)
end

-- [5] AutomaticPlatformHelper
W("---- [5] AutomaticPlatformHelper ----")
local APH = imp("AutomaticPlatformHelper")
for _,m in ipairs({"StartServer","Start","GetPort","RunLua","Listen","IsEnabled",
  "GetDeviceName","Init","Connect","StartRemoteControl"}) do
  T("  APH."..m, function() return type(APH[m]) end)
end

W("========= END =========")
flush()
return "DONE lines="..#L
