-- nova_probe2.lua — إيجاد مفاتيح وحدات GM + فحص مسار اللوبي + hook على المصدر
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe2.txt"
local L = {}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA2] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA2] "..s) end end) end
local function flush() pcall(function()
  local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-34s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end

W("============ NOVA PROBE 2 ============")

-- [1] ابحث في package.loaded عن كل مفاتيح GM/cloud/frontend
W("---- [1] مفاتيح package.loaded ذات الصلة ----")
local keys_gm = {}
pcall(function()
  for k,v in pairs(package.loaded) do
    local ks = tostring(k)
    if ks:find("CloudGM") or ks:find("gm_execute") or ks:find("logic_gm")
       or ks:find("frontend_hud") or ks:find("IngameGM") or ks:lower():find("gmcmd") then
      keys_gm[#keys_gm+1] = ks.."  ["..type(v).."]"
    end
  end
end)
for _,k in ipairs(keys_gm) do W("  KEY: "..k) end
W("  (count matched="..#keys_gm..")")

-- [2] جرّب تحميل ClientCloudGM بمفاتيح محتملة
W("---- [2] تحميل ClientCloudGM ----")
local CloudGM
for _,key in ipairs({
  "GameLua.Mod.BaseMod.Client.ClientCloudGM",
  "GameLua/Mod/BaseMod/Client/ClientCloudGM",
  "ClientCloudGM",
}) do
  local ok,v = pcall(function() return package.loaded[key] end)
  if ok and v then CloudGM=v; W("  found in package.loaded["..key.."]"); break end
end
if not CloudGM then
  -- ربما مُعرّفة كـ global بعد تحميل game_frontend_hud
  pcall(function() require("game_frontend_hud") end)
  CloudGM = _G.ClientCloudGM
  W("  via _G.ClientCloudGM after hud load: "..tostring(CloudGM))
end
T("CloudGM type", function() return type(CloudGM) end)
T("CloudGM.HandleCloudGMCMDStr", function() return CloudGM and type(CloudGM.HandleCloudGMCMDStr) end)

-- [3] افحص logic_gm_execute (مسار اللوبي الفعّال الآن)
W("---- [3] logic_gm_execute (مسار اللوبي) ----")
local gmx
for k,v in pairs(package.loaded) do
  if tostring(k):find("logic_gm_execute") then gmx=v; W("  key="..tostring(k)); break end
end
T("logic_gm_execute type", function() return type(gmx) end)
T("gmx.GMCmd", function() return gmx and type(gmx.GMCmd) end)
if gmx then
  pcall(function() for k,v in pairs(gmx) do W("  gmx."..tostring(k).." = "..type(v)) end end)
end

-- [4] hook على HandleCloudGMCMDStr لرصد أوامر الشبكة
W("---- [4] hook المصدر ----")
T("install hook on HandleCloudGMCMDStr", function()
  if not (CloudGM and CloudGM.HandleCloudGMCMDStr) then return "no handler" end
  if CloudGM.__nova2 then return "already" end
  local orig = CloudGM.HandleCloudGMCMDStr
  CloudGM.__nova2 = true
  CloudGM.HandleCloudGMCMDStr = function(cmd,...)
    pcall(function()
      local f=io.open("/sdcard/Android/data/com.tencent.ig/files/nova_gm_log.txt","a")
      if f then f:write(os.time().." CMD="..tostring(cmd).."\n"); f:close() end
      if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA2][GM] "..tostring(cmd):sub(1,200)) end
    end)
    return orig(cmd,...)
  end
  return "hooked -> nova_gm_log.txt"
end)

-- [5] hook على الـ delegate الأصلي في game_frontend_hud (المصدر الأعمق)
W("---- [5] delegate الأصلي slua ----")
T("hud module", function() return type(require("game_frontend_hud")) end)
-- حاول الوصول لكائن slua_GameFrontendHUD والـ delegate
for _,gname in ipairs({"slua_GameFrontendHUD","GameFrontendHUD","g_GameFrontendHUD"}) do
  T("global "..gname, function() return type(_G[gname]) end)
end

-- [6] PoC: محاكاة فرع loadstring (نحن في لوبي، فنختبر الفرع يدوياً)
W("---- [6] PoC loadstring branch ----")
T("direct load exec", function()
  _G.NOVA_GM_OK=(_G.NOVA_GM_OK or 0)+1
  local fn=load("_G.NOVA_INNER=(_G.NOVA_INNER or 0)+1 return _G.NOVA_INNER")
  return fn and fn()
end)
-- لو عندك طريقة لمعرفة GameStatus خارج لوبي، استدعِ HandleCloudGMCMDStr("loadstring\n...") حينها

W("============ END ============")
flush()
return "DONE lines="..#L
