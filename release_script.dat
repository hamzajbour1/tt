-- nova_probe.lua — تشخيص runtime لـ PUBG Global
-- يكتب المخرجات إلى ملف + print + slua.HamzaCallback
-- الهدف: حسم مسار Cloud GM + خريطة تحميل Lua + APIs الـ stage-2

local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe.txt"
local lines = {}
local function W(s)
  s = tostring(s)
  lines[#lines+1] = s
  pcall(function() print("[NOVA] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA] "..s) end end)
end
local function flush()
  pcall(function()
    local f = io.open(OUT, "w")
    if f then f:write(table.concat(lines, "\n").."\n"); f:close() end
  end)
end
local function tryget(name, fn)
  local ok, res = pcall(fn)
  W(string.format("%-28s : %s", name, ok and tostring(res) or ("ERR "..tostring(res))))
  return ok and res or nil
end

W("================ NOVA PROBE START ================")
W("os.time = "..tostring(os.time()))

-- ======================================================
W("---- [1] بيئة التنفيذ الأساسية ----")
tryget("_VERSION", function() return _VERSION end)
tryget("load exists", function() return type(load) end)
tryget("loadstring exists", function() return type(loadstring) end)
tryget("io.open exists", function() return type(io) == "table" and type(io.open) end)
tryget("debug.getregistry", function() return type(debug) == "table" and type(debug.getregistry) end)
-- اختبار تنفيذ فعلي
tryget("load TEXT exec", function()
  local f = load("return 2+2") ; return f and f()
end)
tryget("load BYTECODE mode", function()
  local f = load("return 7*7", "t", "t") ; return f and f()
end)

-- ======================================================
W("---- [2] واجهات اللعبة (globals) ----")
for _, g in ipairs({
  "GameStatus","ModuleManager","FHttpModule","slua","import","require",
  "NetUtil","FuncUtil","PopUpNoticeUI","TimeUtil","EventSystem",
  "KismetSystemLibrary","UE4","CCallDostring","print"
}) do
  tryget("global "..g, function() return type(_G[g]) end)
end

-- حالة اللعبة (تحدّد فرع Cloud GM)
tryget("GameStatus.GetGameStatus", function() return GameStatus and GameStatus.GetGameStatus and GameStatus.GetGameStatus() end)
tryget("IsInLobbyOrMainCity", function() return GameStatus and GameStatus.IsInLobbyOrMainCity and GameStatus.IsInLobbyOrMainCity() end)

-- ======================================================
W("---- [3] وحدة Cloud GM ----")
local CloudGM = tryget("require ClientCloudGM", function()
  return require("GameLua.Mod.BaseMod.Client.ClientCloudGM")
end)
tryget("ClientCloudGM global", function() return type(_G.ClientCloudGM) end)
tryget("HandleCloudGMCMDStr", function()
  return type((_G.ClientCloudGM or {}).HandleCloudGMCMDStr)
end)

-- ======================================================
W("---- [4] محمّل Lua / البحث ----")
tryget("package", function() return type(package) end)
tryget("package.searchers", function() return package and type(package.searchers) and #package.searchers end)
tryget("package.loaded count", function()
  local n=0 ; if package and package.loaded then for _ in pairs(package.loaded) do n=n+1 end end ; return n
end)
-- هل game_frontend_hud محمّل؟ وفيه delegate؟
tryget("require game_frontend_hud", function() local g=require("game_frontend_hud") ; return type(g) end)

-- ======================================================
W("---- [5] APIs الـ stage-2 (التحميل الشبكي) ----")
tryget("ModuleManager.GetModule", function() return ModuleManager and type(ModuleManager.GetModule) end)
tryget("CommonModuleConfig", function() return ModuleManager and type(ModuleManager.CommonModuleConfig) end)
tryget("AWSHelper key", function() return ModuleManager and ModuleManager.CommonModuleConfig and ModuleManager.CommonModuleConfig.AWSHelper end)
tryget("AWSHelper module", function()
  local h = ModuleManager.GetModule(ModuleManager.CommonModuleConfig.AWSHelper)
  return type(h)
end)
tryget("AWSHelper.DownloadBinary", function()
  local h = ModuleManager.GetModule(ModuleManager.CommonModuleConfig.AWSHelper)
  return h and type(h.DownloadBinary)
end)
tryget("FHttpModule.Get", function() return FHttpModule and type(FHttpModule.Get) end)

-- ======================================================
W("---- [6] اختبار PoC: تنفيذ عبر مسار Cloud GM مباشرة ----")
-- نحاكي ما يفعله HandleCloudGMCMDStr لفرع loadstring (خارج اللوبي)
tryget("manual loadstring-branch exec", function()
  local code = "NOVA_POC_OK = (NOVA_POC_OK or 0) + 1 ; return NOVA_POC_OK"
  local fn = load(code)
  if not fn then return "load failed" end
  return fn()
end)
-- استدعاء الدالة الحقيقية إن أمكن (حذر: قد تتفرّع حسب الحالة)
tryget("call HandleCloudGMCMDStr(loadstring)", function()
  local C = _G.ClientCloudGM
  if not (C and C.HandleCloudGMCMDStr) then return "no handler" end
  -- فرع loadstring يعمل خارج اللوبي فقط
  C.HandleCloudGMCMDStr("loadstring\nNOVA_GM_OK = (NOVA_GM_OK or 0) + 1")
  return "called; NOVA_GM_OK="..tostring(_G.NOVA_GM_OK)
end)

-- ======================================================
W("---- [7] تنصيب hook لرصد أوامر GM الحقيقية ----")
-- نلفّ HandleCloudGMCMDStr لنسجّل أي أمر GM يصل من الشبكة لاحقاً
tryget("install GM hook", function()
  local C = _G.ClientCloudGM
  if not (C and C.HandleCloudGMCMDStr) then return "no handler" end
  if C.__nova_hooked then return "already hooked" end
  local orig = C.HandleCloudGMCMDStr
  C.__nova_hooked = true
  C.HandleCloudGMCMDStr = function(cmd, ...)
    pcall(function()
      local msg = "[GM-RECV] "..tostring(cmd):sub(1,300)
      print("[NOVA]"..msg)
      if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA]"..msg) end
      local f = io.open("/sdcard/Android/data/com.tencent.ig/files/nova_gm_log.txt","a")
      if f then f:write(os.time().." "..tostring(cmd).."\n"); f:close() end
    end)
    return orig(cmd, ...)
  end
  return "hook installed -> logs to nova_gm_log.txt"
end)

W("================ NOVA PROBE END ================")
flush()
return "NOVA_PROBE_DONE lines="..#lines
