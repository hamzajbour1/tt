-- nova_gmprobe.lua  — run via your existing foothold (in-match)
-- Goal: check whether the native Cloud-GM gate is OPEN in retail 4.7
local lines = {}
local function put(s) lines[#lines+1] = tostring(s) end

local hud = rawget(_G, "slua_GameFrontendHUD")
put("== NOVA GM PROBE ==")
put("hud="..tostring(hud))

if hud then
  -- 1) native GM gate flags (UPROPERTY bools exposed via slua reflection)
  for _,k in ipairs({"bEnableCloudGM","bUseGMCommand","bEnableGM","AutoTestGMCommand"}) do
    local ok,v = pcall(function() return hud[k] end)
    put(k.."="..(ok and tostring(v) or ("<err:"..tostring(v)..">")))
  end

  -- 2) is the OnCloudGMReceive delegate present & invocable from Lua?
  local d = nil
  pcall(function() d = hud.OnCloudGMReceive end)
  put("OnCloudGMReceive="..tostring(d))
  if d then
    for _,m in ipairs({"Add","Broadcast","Clear","Contains"}) do
      put("  delegate."..m.."="..tostring(d[m]))
    end
  end

  -- 3) is there a native HANDLER method on the HUD that native itself calls?
  for _,fn in ipairs({"CloudGMHandle","HandleCloudGM","OnRecvCloudGM","OnCloudGMCmd","RecvGMCmd"}) do
    local ok,v = pcall(function() return hud[fn] end)
    put("fn:"..fn.."="..(ok and tostring(v) or "<err>"))
  end

  -- 4) class name for IDA anchoring
  local cls
  pcall(function() cls = hud:GetClass() end)
  put("class="..tostring(cls))
  pcall(function() put("className="..tostring(cls:GetName())) end)
end

local msg = table.concat(lines, "\n")
print(msg)
-- drop to file so NovaMax watchdog / adb can read it
local paths = {
  "/storage/emulated/0/Android/data/com.tencent.ig/files/nova_gmprobe.txt",
  "/sdcard/Android/data/com.tencent.ig/files/nova_gmprobe.txt",
}
for _,p in ipairs(paths) do
  local f = io.open(p,"w"); if f then f:write(msg); f:close() end
end
return msg