-- nova_probe5.lua — NetManager + موزّع s2c + hook حركة الشبكة الحيّة
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe5.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA5] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA5] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-34s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end
local function dumpTable(t, pfx, max)
  local cnt=0
  pcall(function() for k,v in pairs(t) do cnt=cnt+1
    if cnt<=(max or 50) then W(pfx..tostring(k).." = "..type(v)) end end end)
  return cnt
end

W("========= NOVA PROBE 5 =========")

-- [1] NetManager — الموزّع المركزي
W("---- [1] NetManager ----")
local NM = T("require NetManager", function() return require("client.network.comm.NetManager") end)
if type(NM)=="table" then
  W("  NetManager fields:")
  local c = dumpTable(NM, "    NM.", 60)
  W("  (count="..c..")")
end

-- [2] ابحث عن دالة الإرسال/الاستقبال المركزية (send/dispatch/recv)
W("---- [2] دوال الإرسال/الاستقبال ----")
if type(NM)=="table" then
  for _,m in ipairs({"SendMsg","Send","SendProto","SendProtocol","RegisterCallback",
      "RegisterRsp","Register","AddRspListener","OnRsp","DispatchRsp","OnReceive",
      "OnRecvMsg","RecvMsg","SendBufferToServer","SendCsProto"}) do
    T("  NM."..m, function() return type(NM[m]) end)
  end
end

-- [3] NetRsp2IndexConfig — خريطة الرسائل
W("---- [3] NetRsp2IndexConfig ----")
local idx = T("require NetRsp2IndexConfig", function() return require("client.network.comm.NetRsp2IndexConfig") end)
if type(idx)=="table" then
  local c=0
  pcall(function() for k,v in pairs(idx) do c=c+1
    if c<=30 then W("    idx."..tostring(k).." = "..tostring(v):sub(1,40)) end end end)
  W("  (count="..c..")")
end

-- [4] hook على دالة الإرسال لرؤية حركة c2s الحيّة (أسماء الرسائل)
W("---- [4] hook send (c2s live) ----")
T("install send hook", function()
  if type(NM)~="table" then return "no NM" end
  for _,sname in ipairs({"SendCsProto","SendProto","SendMsg","Send","SendProtocol"}) do
    if type(NM[sname])=="function" and not NM["__nova_"..sname] then
      local orig = NM[sname]
      NM["__nova_"..sname]=true
      NM[sname] = function(...)
        local args={...}
        pcall(function()
          local name = tostring(args[1] or args[2] or "?")
          local f=io.open("/sdcard/Android/data/com.tencent.ig/files/nova_net_log.txt","a")
          if f then f:write(os.time().." C2S "..sname.." arg1="..name:sub(1,60).."\n"); f:close() end
        end)
        return orig(...)
      end
      return "hooked "..sname.." -> nova_net_log.txt"
    end
  end
  return "no send func found"
end)

-- [5] افحص معالجات قد تنفّذ أوامر/نصوص من الخادم
W("---- [5] معالجات مشبوهة (exec/console/notice) ----")
for _,mod in ipairs({
  "client.network.Protocol.NoticeHandler",
  "client.network.Protocol.SwitchSysHandler",
  "client.network.Protocol.SettingHandler",
  "client.network.Protocol.StatusHandler",
  "client.common.uibase.ui_show_queue_gm_notice",
}) do
  local ok,m = pcall(require, mod)
  if ok and type(m)=="table" then
    W("  "..mod..":")
    pcall(function() for k,v in pairs(m) do
      local ks=tostring(k):lower()
      if type(v)=="function" and (ks:find("exec")or ks:find("cmd")or ks:find("console")
         or ks:find("eval")or ks:find("load")or ks:find("run")or ks:find("gm")or ks:find("script")) then
        W("    -> "..mod.."."..tostring(k))
      end
    end end)
  end
end

-- [6] هل نستطيع تسجيل معالج s2c خاص بنا؟ (نهج renji لـ Global)
W("---- [6] تسجيل معالج مخصّص ----")
if type(NM)=="table" then
  for _,rname in ipairs({"RegisterRsp","RegisterCallback","AddRspListener","Register","RegRsp","RegisterS2CMsg"}) do
    T("  NM."..rname, function() return type(NM[rname]) end)
  end
end

W("========= END =========")
flush()
return "DONE lines="..#L
