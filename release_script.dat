-- nova_probe8.lua — reautomatic RemoteControl transport + اختبار OnRunLua
local GENV = _ENV
local OUT = "/sdcard/Android/data/com.tencent.ig/files/nova_probe8.txt"
local L={}
local function W(s) s=tostring(s); L[#L+1]=s
  pcall(function() print("[NOVA8] "..s) end)
  pcall(function() if slua and slua.HamzaCallback then slua.HamzaCallback("[NOVA8] "..s) end end) end
local function flush() pcall(function() local f=io.open(OUT,"w"); if f then f:write(table.concat(L,"\n").."\n"); f:close() end end) end
local function T(n,fn) local ok,r=pcall(fn); W(string.format("%-40s : %s",n,ok and tostring(r) or ("ERR "..tostring(r)))); return ok and r or nil end
local function dumpUD(ud,names) for _,m in ipairs(names) do T("  ."..m, function() return type(ud[m]) end) end end

W("========= NOVA PROBE 8 — reautomatic =========")
local imp = GENV.import or import

-- [1] الكلاسات الأصلية للأتمتة — موجودة؟
W("---- [1] كلاسات الأتمتة ----")
for _,cls in ipairs({"RemoteControlHelper","ScriptHelperClient","AutomaticPlatformHelper",
    "AutomaticUIHelper","AutomaticCommonHelper","STExtraGameInstance"}) do
  T("import "..cls, function() local c=imp(cls); return type(c) end)
end

-- [2] RemoteControlHelper — دواله (listen/port/server/send)
W("---- [2] RemoteControlHelper methods ----")
local RC = T("get RemoteControlHelper", function() return imp("RemoteControlHelper") end)
if RC then
  dumpUD(RC, {"GetDeviceName","StartServer","Start","Listen","StartListen","SendResult",
    "SendLog","Init","Connect","GetPort","SetPort","IsConnected","RegisterLuaHandler",
    "SetLuaHandler","BindRunLua","OnRunLua","StartRemoteControl","StartTcp","OpenServer"})
end

-- [3] اختبار OnRunLua مباشرة (fake callback) — هل load+exec يعمل عبر هذا المسار؟
W("---- [3] اختبار OnRunLua مباشرة ----")
T("require remote_handler", function() return type(require("reautomatic.remote_handler")) end)
T("call OnRunLua directly", function()
  local RA = require("reautomatic.remote_handler")
  local fakeCb = { SendResult=function(_,s) W("    [cb.SendResult] "..tostring(s)) end,
                   SendLog=function(_,s) W("    [cb.SendLog] "..tostring(s)) end }
  RA:OnRunLua(nil, "NOVA_RA_OK=(NOVA_RA_OK or 0)+1 return NOVA_RA_OK", fakeCb)
  return "called; NOVA_RA_OK="..tostring(GENV.NOVA_RA_OK)
end)

-- [4] اختبار GetLuaResult command
W("---- [4] GetLuaResult command ----")
T("call GetLuaResult", function()
  local RA = require("reautomatic.remote_handler")
  require("reautomatic.commands.game_commands")
  local CL = require("reautomatic.commands.command_list")
  if type(CL.GetLuaResult)~="function" then return "no GetLuaResult" end
  local fakeCb = { SendResult=function(_,s) W("    [GLR.SendResult] "..tostring(s)) end,
                   SendLog=function(_,s) end }
  CL.GetLuaResult({luaScript="NOVA_GLR=(NOVA_GLR or 0)+1 return NOVA_GLR"}, fakeCb)
  return "called; NOVA_GLR="..tostring(GENV.NOVA_GLR)
end)

-- [5] هل هناك علم تفعيل / server نشط؟
W("---- [5] علم/حالة الأتمتة ----")
local gi = T("STExtraGameInstance", function() local g=imp("STExtraGameInstance"); return type(g) end)
for _,f in ipairs({"bEnableAutoTest","IsAutoTest","bAutoTest","IsRemoteControlEnabled",
    "bEnableRemoteControl","GetAutoTestEnabled"}) do
  T("flag "..f, function() local g=imp("STExtraGameInstance"); return g and type(g[f]) end)
end

-- [6] من يستدعي OnRunLua؟ ابحث في package.loaded عن ربط
W("---- [6] ربط OnRunLua ----")
pcall(function()
  for k,v in pairs(package.loaded) do
    local ks=tostring(k):lower()
    if ks:find("remote") or ks:find("automat") or ks:find("scripthelper") then
      W("  loaded: "..tostring(k))
    end
  end
end)

W("========= END =========")
flush()
return "DONE lines="..#L
